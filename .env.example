OPENAI_API_KEY=sk-...

# Matches docker-compose.yml defaults — change for a remote or prod DB.
DATABASE_URL=postgresql://scorechat:scorechat@localhost:5432/scorechat

# Model providers — pick per pipeline/providers.py. Install the matching
# extra first, e.g. `uv pip install -e ".[anthropic]"` or ".[ollama]".
CHAT_PROVIDER=openai        # openai | anthropic | gemini | openrouter | cloudflare | ollama
# CHAT_MODEL=claude-sonnet-5

# ANTHROPIC_API_KEY=sk-ant-...       # required if CHAT_PROVIDER=anthropic
# OLLAMA_BASE_URL=http://localhost:11434   # optional, for CHAT_PROVIDER=ollama
# GEMINI_API_KEY=AI...                # required if CHAT_PROVIDER=gemini

# Free tiers, both OpenAI-compatible endpoints — no extra package to install.
# Any key set here becomes selectable in the web client's model picker; the
# key stays server-side, only the provider's name crosses to the browser.
# Whichever model you name must support tool calling, or the answer comes back
# with an empty trace and nothing backing it.
# OPENROUTER_API_KEY=sk-or-v1-...     # openrouter.ai — free slugs end in ':free'
# CLOUDFLARE_API_KEY=...              # Workers AI token
# CLOUDFLARE_ACCOUNT_ID=...           # part of the URL, so both are required

# Commentary search (optional). Only the prose of the commentary texts is ever
# embedded -- never the score. Embed with any provider that has a key:
#   python embed_commentary.py --model gemini        (or openrouter, cloudflare, ollama, openai)
# A query must use the model the corpus was embedded with; by default search
# uses whichever model covers the most passages, or this one if set:
# COMMENTARY_EMBEDDING_MODEL=gemini:gemini-embedding-2

# ---------------------------------------------------------------------------
# Serving. Local defaults are fine; these matter on a public deployment, where
# /api/ask answers with *this process's* key for whoever asks (see fly.toml).
# ---------------------------------------------------------------------------
# PORT=8000                           # the host usually assigns this
# ALLOWED_CHAT_PROVIDERS=gemini,openrouter   # unset = every provider with a key
# ASK_RATE_LIMIT=20                   # questions per address, 0 disables
# ASK_RATE_WINDOW=3600                # ...per this many seconds
# TRUST_PROXY=1                       # only behind a proxy that sets the client
                                      # IP; elsewhere the header is caller-supplied
